<Window x:Class="BassRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="BassRouter"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextElement.FontFamily="/Resources/#Sora"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1D1E20">

    <!--  Custom Titlebar  -->
    <WindowChrome.WindowChrome>
        <WindowChrome 
            CaptionHeight="32" 
            ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--  Accent Colors  -->
        <SolidColorBrush x:Key="CardBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#433E46"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1ECF3"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="#F1ECF3"/>
        <SolidColorBrush x:Key="ValueBrush" Color="#F0C050"/>
        <SolidColorBrush x:Key="BottomBarBrush" Color="#151528"/>

        <!-- Fonts -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="/Resources/#Sora"  />
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="/Resources/#Sora" />
        </Style>

        <!--  ComboBox Style  -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource DimTextBrush}"
                                          StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Slide">
                                <Border Background="#1D1E20" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,4,0,0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorLight1BrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorLight1BrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Slider Style  -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="3" CornerRadius="2" Background="#2F2F31" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="2" CornerRadius="2" Background="{DynamicResource {x:Static SystemColors.AccentColorLight1BrushKey}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbDot" Width="12" Height="12" Fill="{StaticResource TextBrush}"
                                                         Effect="{x:Null}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbDot" Property="Width" Value="18"/>
                                                        <Setter TargetName="ThumbDot" Property="Height" Value="18"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Button Style  -->
        <Style x:Key="StartStopButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="24,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="0">

        <!-- PRIMARY AUDIO OUTPUT -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="4"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Margin="14,14,14,0" Padding="10">
            <StackPanel>
                <TextBlock Text="Primary Audio Output" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Device" Foreground="{StaticResource DimTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="ComboPrimaryDevice" Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Artificial Latency" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="TextPrimaryLatencyValue" Grid.Column="1"
                               Text="0 ms" Foreground="{StaticResource ValueBrush}" FontSize="12"/>
                </Grid>
                <Slider x:Name="SliderPrimaryLatency" Style="{StaticResource DarkSlider}"
                        Minimum="0" Maximum="1000" Value="0"
                        TickFrequency="100" IsSnapToTickEnabled="False"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volume" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="TextPrimaryVolumeValue" Grid.Column="1"
                               Text="100%" Foreground="{StaticResource ValueBrush}" FontSize="12"/>
                </Grid>
                <Slider x:Name="SliderPrimaryVolume" Style="{StaticResource DarkSlider}"
                        Minimum="0" Maximum="100" Value="100"
                        TickFrequency="1" IsSnapToTickEnabled="False" />
            </StackPanel>
        </Border>

        <!-- SUBWOOFER AUDIO OUTPUT -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="4"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Margin="14,10,14,0" Padding="10">
            <StackPanel>
                <TextBlock Text="Subwoofer Audio Output" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Device" Foreground="{StaticResource DimTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="ComboSubDevice" Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Artificial Latency" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="TextSubLatencyValue" Grid.Column="1"
                               Text="0 ms" Foreground="{StaticResource ValueBrush}" FontSize="12"/>
                </Grid>
                <Slider x:Name="SliderSubLatency" Style="{StaticResource DarkSlider}"
                        Minimum="0" Maximum="5000" Value="0"
                        TickFrequency="100" IsSnapToTickEnabled="False" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volume" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="TextSubVolumeValue" Grid.Column="1"
                               Text="100%" Foreground="{StaticResource ValueBrush}" FontSize="12"/>
                </Grid>
                <Slider x:Name="SliderSubVolume" Style="{StaticResource DarkSlider}"
                        Minimum="0" Maximum="100" Value="100"
                        TickFrequency="1" IsSnapToTickEnabled="False" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Low Pass Frequency" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="TextLowPassValue" Grid.Column="1"
                               Text="120 Hz" Foreground="{StaticResource ValueBrush}" FontSize="12"/>
                </Grid>
                <Slider x:Name="SliderLowPass" Style="{StaticResource DarkSlider}"
                        Minimum="10" Maximum="300" Value="120"
                        TickFrequency="1" IsSnapToTickEnabled="False" />
            </StackPanel>
        </Border>

        <!-- BOTTOM BAR -->
        <Border Margin="14,14" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TextStatus" Text="Stopped"
                           Foreground="{StaticResource DimTextBrush}" FontSize="13"
                           VerticalAlignment="Center"/>

                <Button x:Name="ButtonStartStop" Grid.Column="1"
                        Content="Start" Background="#0A7A3E"
                        Style="{StaticResource StartStopButton}"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>
