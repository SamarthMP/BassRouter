<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BassRouter.LatencyDetectionWindow"
        Title="Detect Latency"
        Icon="/Resources/Icon.png"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        Background="{StaticResource ContentBrush}">

    <StackPanel>

        <!--  Custom Titlebar (drag to move)  -->
        <Border x:Name="TitleBar" Padding="18,10,10,8" Background="#2A2B2E">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Detect Latency" FontSize="18" FontWeight="Medium" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

                <Button x:Name="ButtonClose" Grid.Column="1" Classes="close" Theme="{StaticResource CaptionButton}" ToolTip.Tip="Close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextBrush}" StrokeThickness="1" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Margin="14">
            <TextBlock FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       Text="Plays a few sweeps on each output, taking turns so the microphone can tell them apart, then lines the outputs up. Takes about 15 seconds, and starts BassRouter if it's stopped." />

            <Border Classes="card" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Classes="label" Text="Microphone" Margin="0,0,0,4" />
                    <ComboBox x:Name="ComboMicrophone" />

                    <Grid ColumnDefinitions="14,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
                        <TextBlock Classes="label" Text="•" />
                        <TextBlock Classes="label" Grid.Column="1" TextWrapping="Wrap" Text="Put the microphone where you sit. For headphones, hold an ear cup against it." />

                        <TextBlock Classes="label" Grid.Row="1" Text="•" Margin="0,4,0,0" />
                        <TextBlock Classes="label" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,4,0,0" Text="Pause other audio and keep the room quiet." />

                        <TextBlock Classes="label" Grid.Row="2" Text="•" Margin="0,4,0,0" />
                        <TextBlock Classes="label" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,4,0,0" Text="Avoid a Bluetooth headset's own microphone, using it switches the headset into a different mode." />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PanelStatus" Margin="0,12,0,0" Spacing="8" IsVisible="False">
                <TextBlock x:Name="TextStatus" FontSize="13" TextWrapping="Wrap" />
                <ProgressBar x:Name="ProgressDetection" IsIndeterminate="True" MinHeight="3" IsVisible="False" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button x:Name="ButtonCancel" Content="Cancel" Theme="{StaticResource SecondaryButton}" />
                <Button x:Name="ButtonStart" Content="Start" Background="#0A7A3E" Theme="{StaticResource StartStopButton}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
